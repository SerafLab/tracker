{
  "name": "tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run check:architecture && npm run test:run && npm run test:e2e",
    "preview": "vite preview",
    "prepare": "npm run setup:git-hooks",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:e2e": "npm run build && playwright test",
    "test:production": "npm run build && vitest --run"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "i18next": "^26.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
